            <div class="hp-kpi-card">
              <div class="hp-kpi-label">Total Spend</div>
              <div class="hp-kpi-value">₹2.93L</div>
              <div class="hp-kpi-change">↓ 40% vs previous 30 days</div>
            </div>
            <div class="hp-kpi-card">
              <div class="hp-kpi-label">Revenue Generated</div>
              <div class="hp-kpi-value">₹9.41L</div>
              <div class="hp-kpi-change">↑ 182% vs previous 30 days</div>
            </div>
            <div class="hp-kpi-card">
              <div class="hp-kpi-label">ROAS</div>
              <div class="hp-kpi-value">3.21x</div>
              <div class="hp-kpi-change">↑ 156% vs previous 30 days</div>
            </div>
            <div class="hp-kpi-card">
              <div class="hp-kpi-label">Cost per Lead</div>
              <div class="hp-kpi-value">₹58.7</div>
              <div class="hp-kpi-change">↓ 40% vs previous 30 days</div>
