<script>
/* Particle background */
const c=document.getElementById('particles');
const x=c.getContext('2d');

function size(){
  c.width=innerWidth;
  c.height=innerHeight;
}
size();
addEventListener('resize',size);

const colors=['#00f0ff','#c8b6ff','#ff2d95','#ffd700','#39ff14'];

const nodes=Array.from({length:55},()=>({
  x:Math.random()*c.width,
  y:Math.random()*c.height,
  vx:(Math.random()-.5)*.3,
  vy:(Math.random()-.5)*.3,
  r:Math.random()*2+1,
  color:colors[Math.floor(Math.random()*colors.length)]
}));

let mouse={x:innerWidth/2,y:innerHeight/2};

addEventListener('mousemove',e=>{
  mouse.x=e.clientX;
  mouse.y=e.clientY;
});

function drawParticles(){
  x.clearRect(0,0,c.width,c.height);

  for(let i=0;i<nodes.length;i++){
    for(let j=i+1;j<nodes.length;j++){
      const dx=nodes[i].x-nodes[j].x;
      const dy=nodes[i].y-nodes[j].y;
      const dist=Math.hypot(dx,dy);

      if(dist<120){
        x.beginPath();
        x.moveTo(nodes[i].x,nodes[i].y);
        x.lineTo(nodes[j].x,nodes[j].y);
        x.strokeStyle=`rgba(0,240,255,${0.08*(1-dist/120)})`;
        x.lineWidth=.5;
        x.stroke();
      }
    }
  }

  nodes.forEach(n=>{
    const dx=mouse.x-n.x;
    const dy=mouse.y-n.y;
    const dist=Math.hypot(dx,dy);

    if(dist<180 && dist>0){
      const force=(1-dist/180)*.4;
      n.vx+=dx/dist*force;
      n.vy+=dy/dist*force;
    }

    n.x+=n.vx;
    n.y+=n.vy;
    n.vx*=.99;
    n.vy*=.99;

    if(n.x<0)n.x=c.width;
    if(n.x>c.width)n.x=0;
    if(n.y<0)n.y=c.height;
    if(n.y>c.height)n.y=0;

    x.beginPath();
    x.arc(n.x,n.y,n.r,0,7);
    x.fillStyle=n.color;
    x.globalAlpha=.6;
    x.fill();
    x.globalAlpha=1;
  });

  requestAnimationFrame(drawParticles);
}
drawParticles();

/* Live date + dashboard scaling */
(()=>{
  const date=document.getElementById('hpTodayDate');
  if(date){
    date.textContent=new Date().toLocaleDateString('en-IN',{
      month:'short',
      day:'numeric',
      year:'numeric'
    });
  }

  const stage=document.querySelector('.hero-performance-stage');
  const graph=document.querySelector('.hero-performance');
  if(!stage||!graph)return;

  const fit=()=>{
    const z=stage.clientWidth/1100;
    if(z>0)graph.style.transform=`scale(${z})`;
  };

  fit();
  addEventListener('resize',fit);

  if(window.ResizeObserver){
    new ResizeObserver(fit).observe(stage);
  }
})();
</script>

