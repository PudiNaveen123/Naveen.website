<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Naveen Kumar — Hero</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root{
  --bg:#04040a;
  --fg:#f0efff;
  --muted:#8a8fb5;
  --neon:#00f0ff;
  --pink:#ff2d95;
  --purple:#a855f7;
  --gold:#ffd700;
  --green:#39ff14;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  font-family:"DM Sans","Segoe UI",system-ui,sans-serif;
  background:var(--bg);
  color:var(--fg);
  overflow-x:hidden;
}
canvas#particles{
  position:fixed;
  inset:0;
  z-index:0;
  pointer-events:none;
}

/* NAV */
nav{
  position:fixed;
  top:0;
  width:100%;
  z-index:50;
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:18px 40px;
  background:rgba(4,4,10,.6);
  border-bottom:1px solid rgba(0,240,255,.06);
  backdrop-filter:blur(16px);
}
.logo{
  font-weight:800;
  font-size:22px;
  letter-spacing:2px;
  background:linear-gradient(90deg,var(--neon),var(--pink),var(--gold));
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}
nav ul{display:flex;gap:28px;list-style:none}
nav a{
  color:var(--muted);
  text-decoration:none;
  font-size:14px;
  font-weight:500;
  transition:.3s;
  position:relative;
}
nav a:hover{color:var(--neon)}
.cta{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  background:linear-gradient(90deg,var(--neon),var(--pink));
  color:#04040a;
  padding:10px 22px;
  border-radius:100px;
  font-weight:700;
  font-size:14px;
  text-decoration:none;
  box-shadow:0 8px 30px rgba(0,240,255,.3);
  transition:.3s;
}
.cta:hover{transform:translateY(-2px);box-shadow:0 12px 40px rgba(255,45,149,.4)}

/* HERO */
.hero{
  position:relative;
  z-index:2;
  display:grid;
  grid-template-columns:.98fr 1.02fr;
  gap:18px;
  align-items:center;
  min-height:100vh;
  max-width:1280px;
  margin:0 auto;
  padding:105px 40px 70px;
}
.hero-content{grid-column:1}
.hero-chart{
  grid-column:2;
  display:flex;
  justify-content:center;
  align-items:center;
}

.badge{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:7px 16px;
  border:1px solid rgba(0,240,255,.3);
  border-radius:100px;
  font-size:12px;
  color:var(--neon);
  letter-spacing:1px;
  margin-bottom:24px;
  background:rgba(0,240,255,.05);
  backdrop-filter:blur(10px);
}
.badge .dot{
  width:8px;height:8px;
  background:var(--neon);
  border-radius:50%;
  animation:breathe 2s ease-in-out infinite;
}
@keyframes breathe{
  0%,100%{transform:scale(1);opacity:1}
  50%{transform:scale(1.3);opacity:.5}
}
.hero h1{
  font-size:clamp(42px,4.5vw,68px);
  line-height:1.04;
  font-weight:800;
  margin-bottom:22px;
  letter-spacing:-1.8px;
}
.hero-line-plain{color:var(--fg)}
.hero-line-two{display:inline-flex;align-items:baseline;gap:.18em}
.hero-line-two em{font-style:normal}
.hero-line-two span{
  background:linear-gradient(90deg,var(--neon),var(--pink),var(--purple),var(--gold),var(--green));
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
  background-size:400%;
  animation:auroraFlow 8s ease infinite;
}
@keyframes auroraFlow{
  0%,100%{background-position:0% 50%}
  50%{background-position:100% 50%}
}
.hero-lead{
  color:#c9cae2;
  font-size:18px;
  max-width:585px;
  margin-bottom:14px;
  line-height:1.55;
  font-weight:500;
}
.hero-small{
  color:var(--muted);
  font-size:14.5px;
  max-width:560px;
  margin-bottom:26px;
  line-height:1.65;
}
.hero .row{
  display:flex;
  gap:16px;
  flex-wrap:nowrap;
  align-items:center;
}
.hero-primary-cta{
  min-width:300px;
  min-height:62px;
  padding-inline:26px;
  font-size:17px;
  font-weight:800;
  background:linear-gradient(105deg,var(--neon),var(--purple),var(--pink),var(--gold),var(--neon));
  background-size:300% 300%;
  animation:heroCtaGradient 4s ease-in-out infinite;
}
@keyframes heroCtaGradient{
  0%{background-position:0% 50%}
  50%{background-position:100% 50%}
  100%{background-position:0% 50%}
}
.btn-ghost{
  min-width:190px;
  min-height:60px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  background:rgba(255,255,255,.03);
  border:1px solid rgba(255,255,255,.1);
  padding:12px 24px;
  border-radius:100px;
  color:var(--fg);
  text-decoration:none;
  font-weight:600;
  font-size:16px;
  transition:.4s;
}
.btn-ghost:hover{
  border-color:var(--pink);
  background:rgba(255,45,149,.08);
  box-shadow:0 0 30px rgba(255,45,149,.2);
  transform:translateY(-2px);
}

/* PERFORMANCE DASHBOARD */
.hero-performance-stage{
  position:relative;
  width:min(630px,50vw);
  aspect-ratio:11/7;
  flex:0 0 auto;
  transform:translateX(-38px);
  overflow:visible;
}
.hero-performance{
  position:absolute;
  left:0;
  top:0;
  width:1100px;
  height:700px;
  padding:45px 20px 55px;
  font-family:Arial,Helvetica,sans-serif;
  transform-origin:0 0;
}
.hero-performance *{box-sizing:border-box}

.hp-dashboard{
  position:relative;
  width:82%;
  margin:35px auto 0;
  padding:32px;
  border-radius:30px;
  overflow:hidden;
  background:#081625 radial-gradient(circle at 50% 45%,rgba(28,70,112,.3),rgba(7,20,35,.98) 68%);
  box-shadow:0 35px 70px rgba(18,54,100,.25),0 10px 30px rgba(0,0,0,.18);
}
.hp-dashboard:before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  background:
    radial-gradient(circle at 20% 20%,rgba(32,104,180,.14),transparent 40%),
    radial-gradient(circle at 80% 80%,rgba(30,80,140,.12),transparent 45%);
}
.hp-dashboard-header,.hp-panel-header,.hp-campaign-header,.hp-campaign-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  position:relative;
}
.hp-dashboard-header{margin-bottom:25px}
.hp-dashboard-title{color:#fff;font-size:17px;font-weight:600}
.hp-date-selector{
  color:#fff;
  background:rgba(18,37,55,.9);
  border:1px solid rgba(255,255,255,.06);
  padding:10px 15px;
  border-radius:10px;
  font-size:12px;
}
.hp-kpi-grid{
  position:relative;
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
  margin-bottom:15px;
}
.hp-kpi-card{
  min-height:105px;
  padding:17px;
  border-radius:13px;
  background:linear-gradient(145deg,rgba(22,43,63,.95),rgba(15,33,50,.92));
  border:1px solid rgba(255,255,255,.035);
}
.hp-kpi-label{color:#9aaabd;font-size:12px;margin-bottom:8px}
.hp-kpi-value{color:#fff;font-size:24px;font-weight:700;margin-bottom:7px}
.hp-kpi-change{font-size:11px;color:#42d88a;font-weight:500}

.hp-dashboard-lower{
  position:relative;
  display:grid;
  grid-template-columns:1.55fr .85fr;
  gap:12px;
}
.hp-graph-panel,.hp-campaign-panel{
  min-height:285px;
  padding:20px;
  border-radius:14px;
  background:linear-gradient(145deg,rgba(17,38,57,.92),rgba(12,29,46,.95));
  border:1px solid rgba(255,255,255,.035);
}
.hp-panel-header{margin-bottom:12px}
.hp-panel-title,.hp-campaign-header{
  color:#fff;
  font-size:13px;
  font-weight:600;
}
.hp-legend{display:flex;gap:15px;color:#9eabba;font-size:10px}
.hp-legend-item{display:flex;align-items:center;gap:5px}
.hp-legend-blue,.hp-legend-green{width:10px;height:3px;border-radius:3px}
.hp-legend-blue{background:#2388ff}
.hp-legend-green{background:#43d991}
.hp-graph{width:100%;height:220px;position:relative}
.hp-graph svg{width:100%;height:100%;overflow:visible}
.hp-grid-line{stroke:rgba(255,255,255,.07);stroke-width:1}
.hp-axis-text,.hp-month-text{fill:#73869a;font-size:9px}
.hp-month-text{text-anchor:middle}
.hp-spend-area{
  fill:url(#hpSpendGradient);
  opacity:0;
  animation:hpFadeArea 1.5s ease 1.3s forwards;
}
.hp-chart-line{
  fill:none;
  stroke-width:3;
  stroke-linecap:round;
  stroke-linejoin:round;
  stroke-dasharray:1000;
  stroke-dashoffset:1000;
  animation:hpDrawChart 2.8s cubic-bezier(.4,0,.2,1) forwards;
}
.hp-spend-line{stroke:url(#hpSpendStroke);filter:drop-shadow(0 0 5px rgba(35,136,255,.45))}
.hp-conversion-line{stroke:#43d991;filter:drop-shadow(0 0 4px rgba(67,217,145,.35));animation-delay:.25s}
.hp-point-glow{opacity:.55;filter:drop-shadow(0 0 4px rgba(95,220,255,.38))}
.hp-point-core{fill:#eafcff;filter:drop-shadow(0 0 3px rgba(255,255,255,.55))}
@keyframes hpFadeArea{to{opacity:1}}
@keyframes hpDrawChart{to{stroke-dashoffset:0}}

.hp-campaign-header{font-size:12px;margin-bottom:25px}
.hp-campaign-header span{color:#8294a6;font-weight:400}
.hp-campaign-row{margin-bottom:21px;color:#dce4eb;font-size:12px}
.hp-campaign-roas{color:#49dc91;font-weight:600}
.hp-view-campaigns{color:#2390ff;font-size:11px;font-weight:600;margin-top:27px}

.hp-result-card{
  position:absolute;
  z-index:10;
  display:flex;
  align-items:center;
  gap:14px;
  background:rgba(255,255,255,.97);
  border-radius:18px;
  padding:16px 21px;
  box-shadow:0 20px 40px rgba(20,55,95,.18),0 5px 15px rgba(0,0,0,.07);
}
.hp-roas-card{
  top:0;left:1%;
  transform:rotate(-2.5deg);
  animation:hpRoasShake 3s ease-in-out infinite;
}
.hp-leads-card{
  bottom:5px;left:7%;
  transform:rotate(-1.5deg);
  animation:hpLeadsShake 3s ease-in-out infinite;
}
.hp-cac-card{
  bottom:5px;right:7%;
  animation:hpCacShake 3s ease-in-out infinite;
}
.hp-result-icon{
  width:58px;height:58px;min-width:58px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  color:#fff;
  font-weight:700;
}
.hp-green-icon{background:linear-gradient(145deg,#42c989,#1caf69);animation:hpFloat 1.8s ease-in-out infinite}
.hp-blue-icon{background:linear-gradient(145deg,#4388ed,#2166c7);animation:hpTilt 2.2s ease-in-out infinite}
.hp-purple-icon{background:linear-gradient(145deg,#8360f4,#6240df);animation:hpJump 1.6s ease-in-out infinite}
.hp-icon-svg{
  width:31px;height:31px;
  stroke:#fff;fill:none;
  stroke-width:2.5;
  stroke-linecap:round;
  stroke-linejoin:round;
}
.hp-result-number{font-size:23px;line-height:1;font-weight:700;color:#17202c;margin-bottom:6px}
.hp-result-label{font-size:12px;line-height:1.4;color:#26313e}

@keyframes hpFloat{
  0%,100%{transform:translateY(0)}
  25%{transform:translateY(-5px)}
  50%{transform:translateY(1px)}
  75%{transform:translateY(-4px)}
}
@keyframes hpTilt{
  0%,100%{transform:rotate(0)}
  25%{transform:rotate(-7deg)}
  50%{transform:rotate(5deg)}
  75%{transform:rotate(-4deg)}
}
@keyframes hpJump{
  0%,35%,65%,100%{transform:translateY(0)}
  20%{transform:translateY(-8px)}
  50%{transform:translateY(-4px)}
}
@keyframes hpRoasShake{
  0%,78%,100%{transform:rotate(-2.5deg) translateX(0)}
  82%{transform:rotate(-1.8deg) translateX(2px)}
  86%{transform:rotate(-3.2deg) translateX(-2px)}
  90%{transform:rotate(-2deg) translateX(1px)}
  94%{transform:rotate(-2.9deg) translateX(-1px)}
}
@keyframes hpLeadsShake{
  0%,78%,100%{transform:rotate(-1.5deg) translateX(0)}
  82%{transform:rotate(-.8deg) translateX(2px)}
  86%{transform:rotate(-2.2deg) translateX(-2px)}
  90%{transform:rotate(-1deg) translateX(1px)}
  94%{transform:rotate(-1.9deg) translateX(-1px)}
}
@keyframes hpCacShake{
  0%,78%,100%{transform:rotate(0) translateX(0)}
  82%{transform:rotate(.7deg) translateX(2px)}
  86%{transform:rotate(-.7deg) translateX(-2px)}
  90%{transform:rotate(.45deg) translateX(1px)}
  94%{transform:rotate(-.45deg) translateX(-1px)}
}

/* RESPONSIVE */
@media(max-width:900px){
  nav{padding:16px 20px}
  nav ul{display:none}
  .hero{
    grid-template-columns:1fr;
    padding:100px 22px 50px;
    min-height:auto;
  }
  .hero-content,.hero-chart{grid-column:1}
  .hero-chart{margin-top:35px}
  .hero-performance-stage{
    width:min(760px,100%);
    transform:none;
    margin:0 auto;
  }
  .hero .row{flex-wrap:wrap}
  .hero-primary-cta,.hero .btn-ghost{min-width:100%}
  .hp-kpi-grid{grid-template-columns:repeat(2,1fr)}
  .hp-dashboard-lower{grid-template-columns:1fr}
}
@media(max-width:600px){
  .hero h1{font-size:43px}
  .hero-lead{font-size:17px}
  .hp-kpi-grid{grid-template-columns:1fr 1fr}
}
</style>
</head>

